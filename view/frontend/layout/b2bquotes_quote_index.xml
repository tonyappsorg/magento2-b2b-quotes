<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Tonyapps\B2bQuotes\Block\Quote\Listing"
                   name="tonyapps.b2b.quotes.list"
                   template="Tonyapps_B2bQuotes::quote/list.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="details" xsi:type="object">Tonyapps\B2bQuotes\ViewModel\QuoteDetails</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
