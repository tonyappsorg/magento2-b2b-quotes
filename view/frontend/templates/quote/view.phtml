<?php
/** @var \Tonyapps\B2bQuotes\Block\Quote\View $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Tonyapps\B2bQuotes\ViewModel\QuoteDetails $details */
$details = $block->getData('details');
$quote = $block->getData('quote');
if (!$quote) {
    return;
}
$status = $details->getStatus($quote);
$replyUrl = $block->getUrl('b2bquotes/quote/reply', ['id' => (int)$quote['entity_id']]);
?>
<div class="b2b-quote-view">
    <p>
        <strong><?= $escaper->escapeHtml(__('Status')) ?>:</strong> <?= $escaper->escapeHtml($details->getStatusLabel($status)) ?>
        <?php if ($quote['expires_at']): ?>
            · <strong><?= $escaper->escapeHtml(__('Valid until')) ?>:</strong> <?= $escaper->escapeHtml((string)$quote['expires_at']) ?>
        <?php endif; ?>
        <?php if ($quote['order_id']): ?>
            · <a href="<?= $escaper->escapeUrl($block->getUrl('sales/order/view', ['order_id' => (int)$quote['order_id']])) ?>"><?= $escaper->escapeHtml(__('View order')) ?></a>
        <?php endif; ?>
    </p>

    <table class="data table">
        <thead><tr>
            <th><?= $escaper->escapeHtml(__('Product')) ?></th>
            <th><?= $escaper->escapeHtml(__('SKU')) ?></th>
            <th><?= $escaper->escapeHtml(__('Qty')) ?></th>
            <th><?= $escaper->escapeHtml(__('Catalog Price')) ?></th>
            <th><?= $escaper->escapeHtml(__('Quoted Price')) ?></th>
        </tr></thead>
        <tbody>
        <?php foreach ($details->getItems($quote) as $item): ?>
            <tr>
                <td><?= $escaper->escapeHtml($item['name']) ?></td>
                <td><?= $escaper->escapeHtml($item['sku']) ?></td>
                <td><?= (float)$item['qty'] ?></td>
                <td><?= $escaper->escapeHtml($details->formatPrice($item['base_catalog_price'], $quote)) ?></td>
                <td><?= $escaper->escapeHtml($details->formatPrice($item['base_negotiated_price'], $quote)) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3"><?= $escaper->escapeHtml(__('Subtotal')) ?></th>
                <td><?= $escaper->escapeHtml($details->formatPrice($quote['base_request_subtotal'], $quote)) ?></td>
                <td><?= $escaper->escapeHtml($details->formatPrice($quote['base_offer_subtotal'], $quote)) ?></td>
            </tr>
        </tfoot>
    </table>

    <h3><?= $escaper->escapeHtml(__('History')) ?></h3>
    <ul class="b2b-quote-history">
        <?php foreach ($details->getHistory($quote) as $entry): ?>
            <li>
                <strong><?= $escaper->escapeHtml($details->getAuthorLabel((string)$entry['author_type'])) ?></strong>,
                <?= $escaper->escapeHtml((string)$entry['created_at']) ?>,
                <?= $escaper->escapeHtml($details->getStatusLabel((string)$entry['status'])) ?>
                <?php if ($entry['comment']): ?><br><?= nl2br($escaper->escapeHtml((string)$entry['comment'])) ?><?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <?php if ($block->canCheckout($quote)): ?>
        <form action="<?= $escaper->escapeUrl($block->getUrl('b2bquotes/quote/checkout', ['id' => (int)$quote['entity_id']])) ?>" method="post">
            <?= $block->getBlockHtml('formkey') ?>
            <?php if ($count = $block->getCartItemCount()): ?>
                <p><?= $escaper->escapeHtml(__('Your cart has %1 product(s). They will be replaced by the products of this quote.', $count)) ?></p>
            <?php endif; ?>
            <button type="submit" class="action primary"><span><?= $escaper->escapeHtml(__('Checkout with This Quote')) ?></span></button>
        </form>
    <?php endif; ?>

    <?php if ($details->isActive($quote)): ?>
        <form action="<?= $escaper->escapeUrl($replyUrl) ?>" method="post">
            <?= $block->getBlockHtml('formkey') ?>
            <label for="b2b-quote-reply"><?= $escaper->escapeHtml(__('Comment for the seller')) ?></label>
            <textarea id="b2b-quote-reply" name="comment" rows="3" maxlength="2000" required></textarea>
            <button type="submit" class="action secondary">
                <span><?= $escaper->escapeHtml($status === 'open' ? __('Send Comment') : __('Send Back to Seller')) ?></span>
            </button>
        </form>
        <form action="<?= $escaper->escapeUrl($replyUrl) ?>" method="post">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="close" value="1"/>
            <button type="submit" class="action secondary"><span><?= $escaper->escapeHtml(__('Close Quote')) ?></span></button>
        </form>
    <?php endif; ?>
</div>
