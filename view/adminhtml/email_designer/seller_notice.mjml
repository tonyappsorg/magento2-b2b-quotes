        <mj-text font-size="12px" font-weight="600" letter-spacing="1px" text-transform="uppercase" color="#f5a623">{{trans "B2B quote #%id" id=$quote_id}}</mj-text>
        <mj-text font-size="24px" font-weight="600">{{var message}}</mj-text>
        <mj-text>{{trans "%buyer from %company." buyer=$buyer_name company=$company_name}}</mj-text>
        <mj-raw ta-block="b2b_quotes_buyer_comment"></mj-raw>
        <mj-raw ta-block="b2b_quotes_items"></mj-raw>
        <mj-button background-color="#1979c3" border-radius="3px" font-size="16px" font-weight="600" inner-padding="14px 32px" href="{{var admin_url}}">{{trans "Open the quote in the admin"}}</mj-button>
        <mj-divider border-width="1px" border-color="#e5e5e5"></mj-divider>
        <mj-text font-size="12px" color="#999999">{{trans "Or go to Sales > B2B Quotes in the admin panel."}}</mj-text>
