<?php
/** @var \Magento\Backend\Block\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Tonyapps\B2bQuotes\ViewModel\QuoteDetails $details */
$details = $block->getData('details');
$quote = $block->getData('quote');
if (!$quote) {
    return;
}
$active = $details->isActive($quote);
?>
<p><a href="<?= $escaper->escapeUrl($block->getUrl('*/*/index')) ?>"><?= $escaper->escapeHtml(__('Back to quotes')) ?></a></p>
<p>
    <strong><?= $escaper->escapeHtml(__('Company')) ?>:</strong> <?= $escaper->escapeHtml((string)$quote['company_name']) ?> ·
    <strong><?= $escaper->escapeHtml(__('Buyer')) ?>:</strong>
    <a href="<?= $escaper->escapeUrl($block->getUrl('customer/index/edit', ['id' => (int)$quote['customer_id']])) ?>"><?= $escaper->escapeHtml($quote['customer_name']) ?></a>
    (<?= $escaper->escapeHtml($quote['customer_email']) ?>) ·
    <strong><?= $escaper->escapeHtml(__('Status')) ?>:</strong> <?= $escaper->escapeHtml($details->getStatusLabel($details->getStatus($quote))) ?>
    <?php if ($quote['order_id']): ?>
        · <a href="<?= $escaper->escapeUrl($block->getUrl('sales/order/view', ['order_id' => (int)$quote['order_id']])) ?>"><?= $escaper->escapeHtml(__('View order')) ?></a>
    <?php endif; ?>
</p>
<form action="<?= $escaper->escapeUrl($block->getUrl('*/*/save', ['id' => (int)$quote['entity_id']])) ?>" method="post">
    <input name="form_key" type="hidden" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
    <table class="data-grid">
        <thead><tr>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Product')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('SKU')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Qty')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Catalog Price')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Negotiated Unit Price (%1)', $quote['base_currency_code'])) ?></th>
        </tr></thead>
        <tbody>
        <?php foreach ($details->getItems($quote) as $item): ?>
            <tr>
                <td><a href="<?= $escaper->escapeUrl($block->getUrl('catalog/product/edit', ['id' => (int)$item['product_id']])) ?>"><?= $escaper->escapeHtml($item['name']) ?></a></td>
                <td><?= $escaper->escapeHtml($item['sku']) ?></td>
                <td><?= (float)$item['qty'] ?></td>
                <td><?= $escaper->escapeHtml($details->formatPrice($item['base_catalog_price'], $quote)) ?></td>
                <td>
                    <?php if ($active): ?>
                        <input type="number" class="admin__control-text" step="0.0001" min="0"
                               name="price[<?= (int)$item['item_id'] ?>]"
                               value="<?= $escaper->escapeHtmlAttr((string)($item['base_negotiated_price'] ?? $item['base_catalog_price'])) ?>"/>
                    <?php else: ?>
                        <?= $escaper->escapeHtml($details->formatPrice($item['base_negotiated_price'], $quote)) ?>
                    <?php endif; ?>
                </td>
            </tr>
        <?php endforeach; ?>
        </tbody>
        <tfoot><tr>
            <th colspan="3"><?= $escaper->escapeHtml(__('Subtotal')) ?></th>
            <td><?= $escaper->escapeHtml($details->formatPrice($quote['base_request_subtotal'], $quote)) ?></td>
            <td><?= $escaper->escapeHtml($details->formatPrice($quote['base_offer_subtotal'], $quote)) ?></td>
        </tr></tfoot>
    </table>

    <h2><?= $escaper->escapeHtml(__('History')) ?></h2>
    <ul>
        <?php foreach ($details->getHistory($quote) as $entry): ?>
            <li>
                <strong><?= $escaper->escapeHtml($details->getAuthorLabel((string)$entry['author_type'])) ?></strong>,
                <?= $escaper->escapeHtml((string)$entry['created_at']) ?>,
                <?= $escaper->escapeHtml($details->getStatusLabel((string)$entry['status'])) ?>
                <?php if ($entry['comment']): ?><br><?= nl2br($escaper->escapeHtml((string)$entry['comment'])) ?><?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <?php if ($active): ?>
        <p>
            <label for="b2b-quote-expires"><?= $escaper->escapeHtml(__('Offer valid until')) ?></label>
            <input id="b2b-quote-expires" type="date" class="admin__control-text" name="expires_at"
                   value="<?= $escaper->escapeHtmlAttr($details->getExpiryInput($quote)) ?>"/>
        </p>
        <p>
            <label for="b2b-quote-comment"><?= $escaper->escapeHtml(__('Comment for the buyer')) ?></label><br>
            <textarea id="b2b-quote-comment" class="admin__control-textarea" name="comment" rows="3" cols="80" maxlength="2000"></textarea>
        </p>
        <button type="submit" name="do" value="offer" class="action-primary"><span><?= $escaper->escapeHtml(__('Send Offer')) ?></span></button>
        <button type="submit" name="do" value="comment" class="action-secondary"><span><?= $escaper->escapeHtml(__('Send Comment Only')) ?></span></button>
        <button type="submit" name="do" value="decline" class="action-secondary"><span><?= $escaper->escapeHtml(__('Decline')) ?></span></button>
    <?php endif; ?>
</form>
