$labels = json_encode([
    'decline' => (string)__('Decline this quote request? The buyer is emailed, with your comment as the reason.'),
    'comment' => (string)__('Enter a comment for the buyer.'),
]);
$currencyJson = json_encode($currency);
$script = <<<JS
(function () {
    var form = document.getElementById('b2b-quote-form');
    var labels = {$labels};
    var money = new Intl.NumberFormat('en-US', {style: 'currency', currency: {$currencyJson}});
    var rows = form.querySelectorAll('tr[data-catalog]');

    function refresh() {
        var catalog = 0, offer = 0;
        rows.forEach(function (row) {
            var input = row.querySelector('.b2b-quote-price');
            var qty = parseFloat(row.dataset.qty), list = parseFloat(row.dataset.catalog);
            var price = parseFloat(input.value.replace(',', '.'));
            catalog += list * qty;
            if (isNaN(price)) {
                row.querySelector('.b2b-quote-discount').textContent = '';
                row.querySelector('.b2b-quote-row-total').textContent = '—';
                return;
            }
            offer += price * qty;
            row.querySelector('.b2b-quote-discount').textContent =
                list > 0 ? (Math.round((1 - price / list) * 1000) / 10) + '%' : '';
            row.querySelector('.b2b-quote-row-total').textContent = money.format(price * qty);
        });
        document.getElementById('b2b-quote-total-offer').textContent = money.format(offer);
        document.getElementById('b2b-quote-total-discount').textContent = money.format(offer - catalog);
    }

    form.addEventListener('input', function (event) {
        if (event.target.classList.contains('b2b-quote-price')) {
            refresh();
        }
    });
    document.getElementById('b2b-quote-apply').addEventListener('click', function () {
        var percent = parseFloat(document.getElementById('b2b-quote-percent').value);
        if (isNaN(percent)) {
            return;
        }
        rows.forEach(function (row) {
            row.querySelector('.b2b-quote-price').value =
                (Math.round(parseFloat(row.dataset.catalog) * (100 - percent)) / 100).toFixed(2);
        });
        refresh();
    });

    window.tonyappsB2bQuoteSubmit = function (action) {
        var comment = form.elements.comment.value.trim();
        if (action === 'comment' && !comment) {
            alert(labels.comment);
            form.elements.comment.focus();
            return;
        }
        if (action === 'decline' && !confirm(labels.decline)) {
            return;
        }
        if (action === 'offer' && !form.reportValidity()) {
            return;
        }
        form.querySelectorAll('.b2b-quote-price').forEach(function (input) {
            input.value = input.value.replace(',', '.');
        });
        form.elements['do'].value = action;
        form.submit();
    };
    refresh();
})();
JS;
